# Server Port (Auto-assigned by Render / Railway or default 5001)
PORT=5001

# JWT Secret for Session & Auth Authentication
JWT_SECRET=life-rpg-ultra-secure-jwt-secret-key-2026

# Hosted Database / MongoDB Connection String
# (e.g. MongoDB Atlas free cluster: mongodb+srv://<user>:<password>@cluster0.mongodb.net/liferpg)
# Either MONGODB_URI or DATABASE_URL can be used
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/liferpg?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/liferpg?retryWrites=true&w=majority

# Production Frontend URL for CORS (e.g. your Vercel/Netlify deployment URL)
FRONTEND_URL=https://life-rpg-client.vercel.app

# SMTP Mail Server Configuration (Optional - for sending real password reset emails)
# Option 1: Gmail App Password
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-16-char-app-password

# Option 2: Custom SMTP Provider (SendGrid, Mailgun, Brevo, AWS SES, Resend)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-api-key
# SMTP_FROM="Life RPG" <noreply@yourdomain.com>
